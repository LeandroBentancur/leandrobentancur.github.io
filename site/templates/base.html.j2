<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
<link rel="stylesheet" href="/style.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<div class="page">

  <header class="masthead">
    <a class="wordmark" href="{{ home_url }}">
      {{ motif|safe }}<b>{{ person.name.first }} {{ person.name.last }}</b>
    </a>
    <nav class="nav">
      <a href="{{ home_url }}"{% if page == 'home' %} aria-current="page"{% endif %}>{{ s.nav.home }}</a>
      <a href="{{ url('research') }}"{% if page == 'research' %} aria-current="page"{% endif %}>{{ s.nav.research }}</a>
      <a href="{{ url('publications') }}"{% if page == 'publications' %} aria-current="page"{% endif %}>{{ s.nav.publications }}</a>
      <a href="{{ person.links.cvuy or '#' }}">{{ s.nav.cv }} ↗</a>
      <a class="lang" href="{{ other_lang_url }}">{{ s.other_lang_name }}</a>
    </nav>
  </header>

  {% block content %}{% endblock %}

  <footer class="colophon">
    <a href="mailto:{{ person.emails.institutional }}">{{ person.emails.institutional }}</a>
    {% if person.links.github %}<a href="{{ person.links.github }}">GitHub ↗</a>{% endif %}
  </footer>

</div>
</body>
</html>
